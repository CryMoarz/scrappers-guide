                "title": "Part type"
              },
              "why": {
                "$ref": "#/$defs/line",
                "title": "Role"
              },
              "core": {
                "type": "boolean",
                "title": "Essential",
                "description": "Switched on by default when the job is searched."
              },
              "only": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 40
                },
                "title": "Only entries mentioning",
                "description": "Narrows a broad part type for this job: only count entries whose spec or device name contains one of these words (e.g. refrigeration compressors, not aquarium air pumps).",
                "x-widget": "lines"
              },
              "need": {
                "type": "object",
                "additionalProperties": false,
                "title": "Ratings needed",
                "description": "What this job needs from the part: volts about this, amps, watts and amp-hours at least this.",
