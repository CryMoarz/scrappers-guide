              },
              "warn": {
                "$ref": "#/$defs/line",
                "title": "Warning"
              }
            }
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 20000,
          "title": "More detail (Markdown)",
          "x-widget": "textarea"
        },
        "tree": {
          "type": "object",
          "title": "Era, branch and what comes first",
          "description": "Its era, its branch, and what you should know or have built first. Shown as Learn first and Leads to links, orders the printed guide, and picks the offline libraries it links to.",
          "required": [
            "era",
            "branch"
          ],
          "additionalProperties": false,
          "properties": {
            "era": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9,
              "title": "Era",
              "description": "1 Fire, 2 Salvage, 3 Low voltage, 4 Power, 5 Machines, 6 Industry (see vocab.eras)."
            },
            "branch": {
