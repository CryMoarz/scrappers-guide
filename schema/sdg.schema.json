            "build",
            "repair",
            "test",
            "safety",
            "skill",
            "reference"
          ],
          "title": "Kind"
        },
        "title": {
          "$ref": "#/$defs/line",
          "title": "Title"
        },
        "keywords": {
          "$ref": "#/$defs/lines",
          "title": "Search words"
        },
        "summary": {
          "$ref": "#/$defs/text",
          "title": "Summary",
