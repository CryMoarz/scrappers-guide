          },
          "title": "Hazards"
        },
        "materials": {
          "type": "array",
          "title": "Materials",
          "items": {
            "type": "object",
            "required": [
              "item"
            ],
            "additionalProperties": false,
            "properties": {
              "item": {
                "$ref": "#/$defs/line",
                "title": "Item"
              },
              "fn": {
                "$ref": "#/$defs/id",
                "x-ref": "parts",
                "title": "Part type"
              },
              "only": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 40
                },
                "title": "Only sources mentioning",
                "description": "When suggesting where to scrap this, only count entries whose spec or device name contains one of these words (e.g. food-grade drums, not fire extinguishers).",
                "x-widget": "lines"
              },
              "qty": {
                "$ref": "#/$defs/line",
