                  },
                  "a": {
                    "type": "number",
                    "minimum": 0,
                    "title": "Amps (at least)"
                  },
                  "w": {
                    "type": "number",
                    "minimum": 0,
                    "title": "Watts (at least)"
                  },
                  "ah": {
                    "type": "number",
                    "minimum": 0,
                    "title": "Amp-hours (at least)"
                  }
                }
              }
            }
          }
        },
        "guides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id",
            "x-ref": "guides"
          },
          "title": "Guides"
        },
